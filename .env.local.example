# ─────────────────────────────────────────────
# Supabase (required)
# ─────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Found in: Supabase Dashboard → Project Settings → API → service_role key
# Keep this server-side only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─────────────────────────────────────────────
# AI / Content Generation (optional — can also be set per-user in Settings)
# ─────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here

# ─────────────────────────────────────────────
# Email delivery (optional — can be set per-user in Settings)
# ─────────────────────────────────────────────
RESEND_API_KEY=re_your-resend-key-here
INBOUND_LEAD_TO_EMAIL=you@example.com
INBOUND_LEAD_FROM_EMAIL=Booked Out <info@trybookedout.com>

# ─────────────────────────────────────────────
# Booked Out lead routing
# ─────────────────────────────────────────────
BOOKED_OUT_OWNER_USER_ID=your-owner-user-uuid
BOOKED_OUT_DEFAULT_SEQUENCE_ID=your-default-sequence-uuid

# ─────────────────────────────────────────────
# SMS (optional — can be set per-user in Settings)
# ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ─────────────────────────────────────────────
# Lead sourcing (optional — can be set per-user in Settings)
# ─────────────────────────────────────────────
OUTSCRAPER_API_KEY=your-outscraper-key-here
BRAVE_API_KEY=your-brave-search-key-here

# Required for every /api/cron/* route. Generate a long random value and set
# the same CRON_SECRET in Vercel; requests must send Authorization: Bearer <value>.
CRON_SECRET=replace-with-a-long-random-secret

# Required for Telegram summaries/reminders. TELEGRAM_THREAD_ID is optional.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
TELEGRAM_THREAD_ID=
NEXT_PUBLIC_APP_URL=https://trybookedout.com

# ─────────────────────────────────────────────
# Development
# ─────────────────────────────────────────────
# Set to true to use fake prospect data (skips all external API calls)
NEXT_PUBLIC_USE_MOCK_DATA=false

# Google Maps Scraper (absolute path to cli.py)
GMAPS_SCRAPER_PATH=/home/d1360/.openclaw/workspace/tools/gmaps-scraper/cli.py
