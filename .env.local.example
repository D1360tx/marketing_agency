# ─────────────────────────────────────────────
# Supabase (required)
# ─────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Found in: Supabase Dashboard → Project Settings → API → service_role key
# Keep this server-side only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─────────────────────────────────────────────
# AI / Content Generation (optional — can also be set per-user in Settings)
# ─────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here

# ─────────────────────────────────────────────
# Email delivery (optional — can be set per-user in Settings)
# ─────────────────────────────────────────────
RESEND_API_KEY=re_your-resend-key-here
INBOUND_LEAD_TO_EMAIL=you@example.com
INBOUND_LEAD_FROM_EMAIL=Booked Out <info@trybookedout.com>

# ─────────────────────────────────────────────
# Booked Out lead routing
# ─────────────────────────────────────────────
BOOKED_OUT_OWNER_USER_ID=your-owner-user-uuid
BOOKED_OUT_DEFAULT_SEQUENCE_ID=your-default-sequence-uuid

# ─────────────────────────────────────────────
# SMS (optional — can be set per-user in Settings)
# ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ─────────────────────────────────────────────
# Lead sourcing (optional — can be set per-user in Settings)
# ─────────────────────────────────────────────
OUTSCRAPER_API_KEY=your-outscraper-key-here
BRAVE_API_KEY=your-brave-search-key-here

# Required for every /api/cron/* route. Requests must send the same value as
# Authorization: Bearer <value>. Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-long-random-secret
# Required to sign email open/click links. Generate with: openssl rand -hex 32
TRACKING_SECRET=replace-with-long-random-secret
# Optional separate unsubscribe signing key. Falls back to TRACKING_SECRET.
UNSUBSCRIBE_SECRET=
# Optional dedicated HMAC secret for public rate-limit fingerprints.
# Falls back to CRON_SECRET when omitted.
PUBLIC_RATE_LIMIT_SECRET=replace-with-long-random-secret

# Optional Cloudflare Turnstile protection. Configure both or neither.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Revenue conversion destinations. Server-side only; public links use /go/* redirects.
BOOKED_OUT_BOOKING_URL=
# Internal SignWell template/workflow URL. /go/agreement requires an authenticated app user.
BOOKED_OUT_AGREEMENT_URL=
BOOKED_OUT_LOCAL_CALL_PAYMENT_URL=

# Required for Telegram summaries/reminders. TELEGRAM_THREAD_ID is optional.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
TELEGRAM_THREAD_ID=
NEXT_PUBLIC_APP_URL=https://trybookedout.com

# ─────────────────────────────────────────────
# Development
# ─────────────────────────────────────────────
# Server-only and ignored in production, even if set to true.
MOCK_DATA=false

# Google Maps Scraper (absolute path to cli.py)
GMAPS_SCRAPER_PATH=/home/d1360/.openclaw/workspace/tools/gmaps-scraper/cli.py
