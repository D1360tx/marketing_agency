{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trybookedout.com/schemas/growth/v1/action-candidate.schema.json",
  "title": "action-candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action_id",
    "tenant_id",
    "subject_type",
    "subject_id",
    "affected_url",
    "evidence_ids",
    "problem",
    "expected_mechanism",
    "priority",
    "confidence",
    "proposed_action",
    "owner",
    "dependencies",
    "verification_method",
    "rollback",
    "approval_required",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "action_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "subject_type": {
      "enum": [
        "prospect",
        "client"
      ]
    },
    "subject_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "affected_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      }
    },
    "problem": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "expected_mechanism": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "priority": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "proposed_action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "dependencies": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      }
    },
    "verification_method": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "rollback": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    },
    "approval_required": {
      "const": true
    },
    "status": {
      "enum": [
        "proposed",
        "approved",
        "executing",
        "verified",
        "rejected",
        "expired",
        "blocked"
      ]
    }
  }
}
