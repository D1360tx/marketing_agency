{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trybookedout.com/schemas/growth/v1/observation.schema.json",
  "title": "observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "tenant_id",
    "subject_type",
    "subject_id",
    "identity",
    "source_type",
    "source_url",
    "source_status",
    "observed_at",
    "expires_at",
    "query",
    "geography",
    "device",
    "language",
    "channel",
    "value",
    "confidence",
    "limitations",
    "collector_version"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "observation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "subject_type": {
      "const": "prospect"
    },
    "subject_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "subject_id",
        "business_name",
        "website_url",
        "maps_url"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "subject_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "business_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "website_url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "maps_url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        }
      }
    },
    "source_type": {
      "const": "cached_local_serp"
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048
    },
    "source_status": {
      "enum": [
        "verified",
        "unavailable",
        "blocked",
        "not_due",
        "stale"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "geography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "city",
        "region",
        "country"
      ],
      "properties": {
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "country": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "device": {
      "enum": [
        "desktop",
        "mobile"
      ]
    },
    "language": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "channel": {
      "enum": [
        "maps",
        "organic"
      ]
    },
    "value": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "depth",
            "complete",
            "results"
          ],
          "properties": {
            "depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "complete": {
              "const": true
            },
            "results": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "position",
                  "name",
                  "url",
                  "kind"
                ],
                "properties": {
                  "position": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 2048
                  },
                  "kind": {
                    "enum": [
                      "business",
                      "directory"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "limitations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "collector_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    }
  }
}
